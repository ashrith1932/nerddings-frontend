{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,

    "baseUrl": ".",
    "plugins": [{ "name": "next" }],

    "paths": {
      "@/*": ["./src/*"],
      "@/components/app/ProfileSectionTabs": [
        "./src/components/app/ProfileSectionTabsV3.tsx"
      ],
      "@/components/app/PostDetailSurface": [
        "./src/components/app/PostDetailSurfaceV2.tsx"
      ],
      "@/components/app/NerddingProjectInteractionLayer": [
        "./src/components/app/NerddingProjectInteractionLayerV2.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}